# Copy to .env. Relative paths are resolved from the working directory.

# Database and logs
DATA_DIR=./data
# The archive itself; point this at the TubeArchivist media folder to import in place
MEDIA_DIR=./media

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Octal mask for files and folders YouHoard creates; 002 keeps them group-writable
# UMASK=002

# Netscape-format cookies for private playlists or when YouTube asks for a bot check.
# Never commit this file.
# YTDLP_COOKIE_FILE=/path/to/cookies.txt

# yt-dlp needs a JavaScript runtime for YouTube. Deno is installed with the Python
# dependencies; set these to use another one (node, bun, quickjs).
# YTDLP_JS_RUNTIME=deno
# YTDLP_JS_RUNTIME_PATH=/usr/local/bin/deno

# Seconds between starting YouTube requests
# YTDLP_REQUEST_INTERVAL=2
